# ------------------------
# Redis
# ------------------------
# Generate using `openssl rand -base64 24`
REDIS_PASSWORD=
# ------------------------

# ------------------------
# Kafka/Redpanda
# ------------------------
KAFKA_BROKERS=
REDPANDA_CONSOLE_PORT=
# ------------------------

# ------------------------
# ClickStack
# ------------------------
CLICKSTACK_OTLP_GRPC_PORT=4317
CLICKSTACK_OTLP_HTTP_PORT=4318
CLICKSTACK_OTLP_UI_PORT=8080
CLICKSTACK_OTLP_HTTP_INTERFACE_PORT=8123
